{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true,
    "strict": true,
    // TypeORM fills entity properties itself, so they are declared without initialisers.
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // Off: TypeORM's migration:generate writes `import { MigrationInterface }`
    // without `import type`, which verbatimModuleSyntax rejects.
    "verbatimModuleSyntax": false,
    "erasableSyntaxOnly": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  // migrations/ sits next to src/ (ADR 0004 section 4), so both are compiled.
  "include": ["src", "migrations"]
}
